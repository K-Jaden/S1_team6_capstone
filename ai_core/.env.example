# =================================================================
# [AI 모델 설정] - Google Gemini
# =================================================================
# Google AI Studio(https://aistudio.google.com/)에서 발급받은 키
GOOGLE_API_KEY=your_gemini_api_key_here

# =================================================================
# [이미지 생성 설정] - Cloudflare Workers AI
# =================================================================
# Cloudflare 대시보드에서 발급받은 Account ID 및 API Token
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token

# =================================================================
# [탈중앙 저장소 설정] - Pinata (IPFS)
# =================================================================
# AI 에이전트 대화 로그를 IPFS에 업로드하기 위한 키
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_API_KEY=your_pinata_secret_key

# =================================================================
# [블록체인 네트워크 설정] - Hardhat
# =================================================================
# 도커 내부에서 호스트의 하드햇 노드 접속 시: http://host.docker.internal:8545
BLOCKCHAIN_URL=http://host.docker.internal:8545

# 하드햇 노드 실행 시 출력되는 Account #0의 Private Key (0x 포함)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# npx hardhat run scripts/deploy.js 실행 후 출력된 ArtPlanningDAO 주소
CONTRACT_ADDRESS=