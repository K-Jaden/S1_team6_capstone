# =================================================================
# [BLOCKCHAIN] - Hardhat & Smart Contract
# =================================================================
# 도커 내부에서 로컬 하드햇 노드 접속 시: http://host.docker.internal:8545
# 로컬(호스트)에서 접속 시: http://127.0.0.1:8545
BLOCKCHAIN_URL=http://host.docker.internal:8545

# npx hardhat node 실행 시 출력되는 Account #0의 Private Key (0x 포함)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# npx hardhat run scripts/deploy.js 실행 후 출력된 컨트랙트 주소
CONTRACT_ADDRESS=

# =================================================================
# [AI CORE] - Gemini & Agents
# =================================================================
# Google AI Studio에서 발급받은 Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# =================================================================
# [STORAGE] - IPFS (Pinata)
# =================================================================
# Pinata API를 사용하여 AI 로그를 IPFS에 저장할 때 필요
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# =================================================================
# [DATABASE] - MySQL & Vector DB
# =================================================================
# Docker-compose에 설정된 DB 정보와 일치해야 함
DB_USER=user
DB_PASSWORD=password
DB_NAME=art_platform
DATABASE_URL=mysql+pymysql://user:password@db:3306/art_platform

# ChromaDB endpoint
CHROMA_URL=http://chroma:8000

# =================================================================
# [FRONTEND] - React Environment
# =================================================================
# 프론트엔드에서 백엔드 API를 호출할 주소
REACT_APP_API_URL=http://localhost:8000