# Cloudflare FLUX API
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Pinata IPFS API
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# Server_REACT_API(local -> localhost:3000/server -> publicip:port)
REACT_APP_API_URL=

# Google Gemini API
GOOGLE_API_KEY=

# Serper API
SERPER_API_KEY=

# Ethereum/Hardhat
CONTRACT_ADDRESS=
PRIVATE_KEY=

# 백엔드가 온체인 트랜잭션(라운드 시작/마감)에 사용하는 관리자 키.
# 로컬 개발 시 hardhat node 실행 화면에 출력되는 Account #0의 Private Key를 넣으세요.
# (예: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 - Hardhat 공개 테스트 키)
# 미설정 시 온체인 기능만 꺼진 채 서버는 정상 동작합니다.
ADMIN_PRIVATE_KEY=
